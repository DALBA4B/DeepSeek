# .gitignore
# ===========================================
# DeepSeek Telegram Bot
# ===========================================

# Environment variables (NEVER commit real secrets!)
.env
.env.local
.env.*.local
.env.production
.env.development

# Firebase credentials (be extra careful!)
*firebase*.json
firebase-adminsdk-*.json
deep-seek-chat-manager-firebase-adminsdk-*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv/
.virtualenv/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
logs/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter
.ipynb_checkpoints/

# Telegram history exports (personal chat data — never commit)
[0-9][0-9].[0-9][0-9].[0-9][0-9][0-9][0-9]-*.json
result.json
import_progress.json
import_names.json
graph_audit_report.md

# Temp dump of a credential value for pasting into hosting UI
_railway_value.txt

# Exported knowledge graph (regenerate with graph_export.py)
graph.gexf

# Graph tooling run artifacts — snapshots of a specific graph state, stale the
# moment anything is imported. Regenerate with graph_merge.py / graph_cleanup.py.
merge_plan.json
desc_snapshot.json

# Throwaway probes: one-off scripts and their output, written to answer a single
# question about the live graph (which mode finds more, where the context budget
# goes). Kept locally because re-running one is how a measurement gets rechecked,
# but they hardcode this graph's state and mean nothing in the repo.
_*.py
_*.json
_*.txt
