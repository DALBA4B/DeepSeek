# ===========================================
# DeepSeek Telegram Bot Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env with real credentials!

# --- Required API Keys ---

# Telegram Bot Token (get from @BotFather)
TELEGRAM_TOKEN=your_telegram_token_here

# DeepSeek API Key (from https://api.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Giphy API Key (from https://developers.giphy.com)
GIPHY_API_KEY=your_giphy_api_key_here

# OpenAI API key — used for embeddings in LightRAG (V2 memory system)
OPENAI_API_KEY=your_openai_api_key_here

# Firebase credentials — EITHER a full JSON string (FIREBASE_CRED_JSON, for Railway/
# Render) OR a path to a JSON file (FIREBASE_CRED_PATH, for local dev).
# Leave both empty to run without long-term memory.
# FIREBASE_CRED_JSON={"type":"service_account","project_id":"...","private_key":"..."}
# FIREBASE_CRED_PATH=path/to/firebase-credentials.json

# --- Bot Settings ---

# Bot display name (used in the persona prompt and for mention detection)
BOT_NAME=YourBotName

# Optional: restrict bot to a specific chat ID (group chat IDs are negative numbers).
# Leave empty to allow all chats.
CHAT_ID=

# --- Memory Settings (Optional) ---

# Maximum messages in short-term memory (default: 30)
# SHORT_MEMORY_LIMIT=30

# Messages to include in DeepSeek context (default: 20)
# CONTEXT_MESSAGES_COUNT=20

# --- DeepSeek Settings (Optional) ---

# DeepSeek API base URL (default: https://api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek model name (V4: deepseek-v4-flash; legacy V3: deepseek-chat)
# DEEPSEEK_MODEL=deepseek-v4-flash

# Temperature for response creativity (default: 1.0)
# Higher = more creative, Lower = more deterministic
# DEEPSEEK_TEMPERATURE=1.0

# Per-attempt request timeout in seconds (default: 30.0)
# DEEPSEEK_TIMEOUT=30.0

# Retry/backoff for the main answer generation call (default: 3 attempts, 0.5s base delay)
# DEEPSEEK_MAX_ATTEMPTS=3
# DEEPSEEK_RETRY_BASE_DELAY=0.5

# Retry/backoff for the fast per-message classifier (default: 2 attempts, 0.4s base delay)
# Keep this small — it runs on every incoming message.
# CLASSIFIER_MAX_ATTEMPTS=2
# CLASSIFIER_RETRY_BASE_DELAY=0.4

# --- Response Settings (Optional) ---

# Text-only mode: only text responses, no stickers/GIFs/reactions (default: false)
# Set to true to force plain text only (disables GIFs/stickers/reactions entirely)
TEXT_ONLY_MODE=false

# Probability of random response (default: 0.1 = 10%)
# RANDOM_RESPONSE_PROBABILITY=0.1

# Chance of an UNPROMPTED gif/sticker/reaction reply, when nobody explicitly
# asked for one (default: 0.05 = 5%). An explicit request ("скинь гифку")
# always bypasses this and is honored directly, regardless of this setting.
# MEDIA_RESPONSE_PROBABILITY=0.05

# Chance of an unprompted GIF specifically, kept lower than
# MEDIA_RESPONSE_PROBABILITY since a GIF is a network round-trip that can be
# slow/fail (default: 0.015 = 1.5%).
# GIF_RESPONSE_PROBABILITY=0.015

# Chance of just reacting (no text reply) to a message the bot would
# otherwise fully ignore (grade 0) — e.g. someone told a joke elsewhere in
# the conversation and the bot acknowledges it without butting in
# (default: 0.03 = 3%).
# SILENT_REACTION_PROBABILITY=0.03

# --- Giphy Settings (Optional) ---

# Giphy API URL (default: https://api.giphy.com/v1/gifs/search)
# GIPHY_API_URL=https://api.giphy.com/v1/gifs/search

# Number of GIFs to fetch (default: 10)
# GIPHY_LIMIT=10

# Content rating filter (default: pg-13)
# GIPHY_RATING=pg-13

# --- Scheduler Settings (Optional) ---

# Hour for nightly DeepSeek analysis (default: 3 = 3:00 AM)
# NIGHTLY_ANALYSIS_HOUR=3

# Minute for nightly analysis (default: 0)
# NIGHTLY_ANALYSIS_MINUTE=0

# Timezone for scheduler (default: Europe/Kiev)
# TIMEZONE=Europe/Kiev

# ===========================================
# LightRAG — Long-term Knowledge Base (V2)
# ===========================================
# LightRAG is deployed as a SEPARATE service (Railway). The bot only talks
# to it over HTTP. The LLM (DeepSeek) and embedding (OpenAI) models used by
# LightRAG for extraction/indexing are configured ON the LightRAG side —
# they do NOT live here.

# Master switch for the whole memory system (default: true)
LIGHTRAG_ENABLED=true

# Base URL of your LightRAG service (no /webui suffix needed)
LIGHTRAG_API_URL=https://your-lightrag-service.up.railway.app

# Basic-auth credentials (must match AUTH_ACCOUNTS on the LightRAG service)
LIGHTRAG_API_USER=Tima
LIGHTRAG_API_PASSWORD=your_lightrag_password

# Retrieval mode: mix | hybrid | local | global | naive (default: mix)
# mix gave the best results in testing (graph + vectors + raw text)
LIGHTRAG_QUERY_MODE=mix

# How many chunks/entities to retrieve per query (default: 5)
LIGHTRAG_QUERY_TOP_K=5

# Seconds to wait for a query answer before giving up (default: 8.0)
LIGHTRAG_QUERY_TIMEOUT=8.0

# Seconds to wait for an insert acknowledgement (default: 15.0)
LIGHTRAG_INSERT_TIMEOUT=15.0

# --- Nightly Ingest (chat -> LightRAG) ---

# Master switch for nightly indexing (default: true)
RAG_INGEST_ENABLED=true

# How often to ingest: 1 = every night, 3 = every 3 days, 7 = weekly (default: 1)
RAG_INGEST_EVERY_N_DAYS=1

# Group messages into N-minute blocks before insert (default: 15)
# Keeps "ahah/agreed" replies in the same chunk as the message they react to
RAG_INGEST_TIMEBLOCK_MINUTES=15

# Hard cap on messages per block (default: 30)
RAG_INGEST_MAX_PER_BLOCK=30

# --- Logging (Optional) ---

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO

# Log format (default: %(asctime)s - %(name) - %(levelname) - %(message))
# LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
